    "@upstash/qstash": "^2.12.2",
    "@vercel/blob": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "js-yaml": "^5.4.1",
    "lucide-react": "^1.8.0",
    "next": "^16.4.3",
    "playwright-core": "^1.61.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
